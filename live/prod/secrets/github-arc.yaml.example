# Run make init once to configure your SOPS key.
# Run make secrets FILE=live/prod/secrets/github-arc.yaml to create and edit the encrypted file.
# Replace placeholders in the editor; commit the encrypted file, never plaintext.
apiVersion: v1
kind: Secret
metadata:
  name: github-arc
  namespace: arc-runners
type: Opaque
stringData:
  github_app_id: REPLACE_ME
  github_app_installation_id: REPLACE_ME
  github_app_private_key: REPLACE_ME
