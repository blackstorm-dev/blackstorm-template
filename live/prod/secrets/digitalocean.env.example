# Run make init once to configure your SOPS key.
# Run make secrets FILE=live/prod/secrets/digitalocean.env to create and edit the encrypted file.
# Replace placeholders in the editor; commit the encrypted file, never plaintext.
DIGITALOCEAN_TOKEN=REPLACE_ME
SPACES_ACCESS_KEY_ID=REPLACE_ME
SPACES_SECRET_ACCESS_KEY=REPLACE_ME
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
