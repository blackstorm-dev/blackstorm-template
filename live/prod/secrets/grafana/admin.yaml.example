# Run make init once to configure your SOPS key.
# Run make secrets FILE=live/prod/secrets/grafana/admin.yaml to create and edit the encrypted file.
# Replace placeholders in the editor; commit the encrypted file, never plaintext.
apiVersion: isindir.github.com/v1alpha3
kind: SopsSecret
metadata:
  name: grafana-admin
  namespace: o11y
spec:
  secretTemplates:
  - name: grafana-admin
    stringData:
      admin-user: REPLACE_ME
      admin-password: REPLACE_ME
