# Run make init once to configure your SOPS key.
# Run make secrets FILE=live/prod/secrets/argo-rollouts/oidc.yaml to create and edit the encrypted file.
# Replace placeholders in the editor; commit the encrypted file, never plaintext.
apiVersion: isindir.github.com/v1alpha3
kind: SopsSecret
metadata:
  name: argo-rollouts-oidc
  namespace: argo-rollouts
  annotations:
    argocd.argoproj.io/sync-wave: '-1'
spec:
  secretTemplates:
  - name: argo-rollouts-oidc
    type: Opaque
    stringData:
      client-secret: REPLACE_ME
