# Run make init once to configure your SOPS key.
# Run make secrets FILE=live/prod/secrets/argocd/oidc.yaml to create and edit the encrypted file.
# Replace placeholders in the editor; commit the encrypted file, never plaintext.
apiVersion: isindir.github.com/v1alpha3
kind: SopsSecret
metadata:
  name: argocd-oidc
  namespace: argocd
spec:
  secretTemplates:
  - name: argocd-oidc
    labels:
      app.kubernetes.io/part-of: argocd
    stringData:
      clientSecret: REPLACE_ME
