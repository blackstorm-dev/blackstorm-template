# Run make init once to configure your SOPS key.
# Run make secrets FILE=live/prod/secrets/velero/spaces.yaml to create and edit the encrypted file.
# Replace placeholders in the editor; commit the encrypted file, never plaintext.
apiVersion: isindir.github.com/v1alpha3
kind: SopsSecret
metadata:
  name: velero-spaces
  namespace: velero
spec:
  secretTemplates:
  - name: velero-spaces
    stringData:
      cloud: '[default]

        aws_access_key_id = REPLACE_ME

        aws_secret_access_key = REPLACE_ME

        '
