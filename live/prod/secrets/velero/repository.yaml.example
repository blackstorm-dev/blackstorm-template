# Run make init once to configure your SOPS key.
# Run make secrets FILE=live/prod/secrets/velero/repository.yaml to create and edit the encrypted file.
# Replace placeholders in the editor; commit the encrypted file, never plaintext.
apiVersion: isindir.github.com/v1alpha3
kind: SopsSecret
metadata:
  name: velero-repo-credentials
  namespace: velero
spec:
  secretTemplates:
  - name: velero-repo-credentials
    stringData:
      repository-password: REPLACE_ME
