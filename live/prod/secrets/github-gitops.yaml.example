# Run make init once to configure your SOPS key.
# Run make secrets FILE=live/prod/secrets/github-gitops.yaml to create and edit the encrypted file.
# Replace placeholders in the editor; commit the encrypted file, never plaintext.
apiVersion: isindir.github.com/v1alpha3
kind: SopsSecret
metadata:
  name: github-gitops
  namespace: argocd
spec:
  secretTemplates:
  - name: github-gitops
    labels:
      argocd.argoproj.io/secret-type: repo-creds
    stringData:
      type: git
      url: https://github.com/example-org
      githubAppID: REPLACE_ME
      githubAppInstallationID: REPLACE_ME
      githubAppPrivateKey: REPLACE_ME
