# Run make init once to configure your SOPS key.
# Run make secrets FILE=live/prod/secrets/stackgres/admin.yaml to create and edit the encrypted file.
# Replace placeholders in the editor; commit the encrypted file, never plaintext.
apiVersion: isindir.github.com/v1alpha3
kind: SopsSecret
metadata:
  name: stackgres-admin
  namespace: stackgres
spec:
  secretTemplates:
  - name: stackgres-admin
    labels:
      api.stackgres.io/auth: user
    stringData:
      k8sUsername: REPLACE_ME
      apiUsername: REPLACE_ME
      password: REPLACE_ME
      clearPassword: REPLACE_ME
