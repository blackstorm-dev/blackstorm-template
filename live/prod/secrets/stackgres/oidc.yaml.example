# Run make init once to configure your SOPS key.
# Run make secrets FILE=live/prod/secrets/stackgres/oidc.yaml to create and edit the encrypted file.
# Replace placeholders in the editor; commit the encrypted file, never plaintext.
apiVersion: isindir.github.com/v1alpha3
kind: SopsSecret
metadata:
  name: stackgres-oidc
  namespace: stackgres
spec:
  secretTemplates:
  - name: stackgres-oidc
    stringData:
      client-secret: REPLACE_ME
