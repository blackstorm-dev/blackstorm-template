# Run make init once to configure your SOPS key.
# Run make secrets FILE=live/local/secrets/kargo/github.yaml to create and edit the encrypted file.
# Replace placeholders in the editor; commit the encrypted file, never plaintext.
apiVersion: isindir.github.com/v1alpha3
kind: SopsSecret
metadata:
  name: github-gitops
  namespace: kargo-shared-resources
spec:
  secretTemplates:
  - name: github-gitops
    labels:
      kargo.akuity.io/cred-type: git
    stringData:
      githubAppID: REPLACE_ME
      githubAppInstallationID: REPLACE_ME
      githubAppPrivateKey: REPLACE_ME
      repoURL: REPLACE_ME
      repoURLIsRegex: 'true'
