# Run make init once to configure your SOPS key.
# Run make secrets FILE=live/local/secrets/kargo/admin.yaml to create and edit the encrypted file.
# Replace placeholders in the editor; commit the encrypted file, never plaintext.
apiVersion: isindir.github.com/v1alpha3
kind: SopsSecret
metadata:
  name: kargo-admin
  namespace: kargo
spec:
  secretTemplates:
  - name: kargo-admin
    stringData:
      ADMIN_ACCOUNT_PASSWORD_HASH: REPLACE_ME
      ADMIN_ACCOUNT_TOKEN_SIGNING_KEY: REPLACE_ME
      ADMIN_ACCOUNT_PASSWORD: REPLACE_ME
