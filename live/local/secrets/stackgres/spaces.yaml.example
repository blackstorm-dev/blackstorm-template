# Run make init once to configure your SOPS key.
# Run make secrets FILE=live/local/secrets/stackgres/spaces.yaml to create and edit the encrypted file.
# Replace placeholders in the editor; commit the encrypted file, never plaintext.
apiVersion: isindir.github.com/v1alpha3
kind: SopsSecret
metadata:
  name: stackgres-spaces
  namespace: stackgres
spec:
  secretTemplates:
  - name: stackgres-spaces
    stringData:
      accessKeyId: REPLACE_ME
      secretAccessKey: REPLACE_ME
