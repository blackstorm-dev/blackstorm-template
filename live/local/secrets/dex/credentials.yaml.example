# Run make init once to configure your SOPS key.
# Run make secrets FILE=live/local/secrets/dex/credentials.yaml to create and edit the encrypted file.
# Replace placeholders in the editor; commit the encrypted file, never plaintext.
apiVersion: isindir.github.com/v1alpha3
kind: SopsSecret
metadata:
  name: dex-credentials
  namespace: identity
spec:
  secretTemplates:
  - name: dex-credentials
    stringData:
      GITHUB_CLIENT_ID: REPLACE_ME
      GITHUB_CLIENT_SECRET: REPLACE_ME
      ARGOCD_CLIENT_SECRET: REPLACE_ME
      GRAFANA_CLIENT_SECRET: REPLACE_ME
      VELERO_UI_CLIENT_SECRET: REPLACE_ME
      STACKGRES_CLIENT_SECRET: REPLACE_ME
      GATUS_CLIENT_SECRET: REPLACE_ME
