# Run make init once to configure your SOPS key.
# Run make secrets FILE=live/local/secrets/gatus/oidc.yaml to create and edit the encrypted file.
# Replace placeholders in the editor; commit the encrypted file, never plaintext.
apiVersion: isindir.github.com/v1alpha3
kind: SopsSecret
metadata:
  name: gatus-oidc
  namespace: o11y
spec:
  secretTemplates:
  - name: gatus-oidc
    stringData:
      client-secret: REPLACE_ME
