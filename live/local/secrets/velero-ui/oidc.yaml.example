# Run make init once to configure your SOPS key.
# Run make secrets FILE=live/local/secrets/velero-ui/oidc.yaml to create and edit the encrypted file.
# Replace placeholders in the editor; commit the encrypted file, never plaintext.
apiVersion: isindir.github.com/v1alpha3
kind: SopsSecret
metadata:
  name: velero-ui-oidc
  namespace: velero
spec:
  secretTemplates:
  - name: velero-ui-oidc
    stringData:
      client-secret: REPLACE_ME
