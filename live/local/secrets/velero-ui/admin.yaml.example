# Run make init once to configure your SOPS key.
# Run make secrets FILE=live/local/secrets/velero-ui/admin.yaml to create and edit the encrypted file.
# Replace placeholders in the editor; commit the encrypted file, never plaintext.
apiVersion: isindir.github.com/v1alpha3
kind: SopsSecret
metadata:
  name: velero-ui-admin
  namespace: velero
spec:
  secretTemplates:
  - name: velero-ui-admin
    stringData:
      password: REPLACE_ME
      pass_phrase: REPLACE_ME
