FROM nginx:1.28-alpine
COPY . /usr/share/nginx/html

# HTML must revalidate to discover the asset URLs generated by MkDocs.
# Keep this inline: the image's build context contains only the generated site.
COPY <<'EOF' /etc/nginx/conf.d/default.conf
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header Cache-Control "no-cache" always;

    location / {
        try_files $uri $uri/ =404;
    }

    location ~* \.(png|jpe?g|gif|svg|webp|avif|ico|css|js|mp4|webm)$ {
        add_header Cache-Control "public, max-age=14400";
        try_files $uri =404;
    }
}
EOF
