{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "environment",
    "domain",
    "github",
    "cluster",
    "identity",
    "backups"
  ],
  "properties": {
    "environment": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
    },
    "github": {
      "type": "object",
      "required": [
        "organization",
        "infrastructureRepository",
        "discoveryTopic"
      ],
      "properties": {
        "organization": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "infrastructureRepository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "discoveryTopic": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        }
      }
    },
    "cluster": {
      "type": "object",
      "properties": {
        "httpsPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "identity": {
      "type": "object",
      "required": [
        "adminUsername",
        "adminEmail",
        "allowedSubjects",
        "rolloutsClient"
      ],
      "properties": {
        "adminUsername": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+$"
        },
        "adminEmail": {
          "type": "string",
          "format": "email"
        },
        "allowedSubjects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rolloutsClient": {
          "type": "boolean"
        }
      }
    },
    "backups": {
      "type": "object",
      "required": [
        "bucket",
        "region"
      ],
      "properties": {
        "bucket": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
